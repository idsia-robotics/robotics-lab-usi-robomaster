[submodule "src/robomaster_sim"]
	path = src/robomaster_sim
	url = git@github.com:jeguzzi/robomaster_sim.git
	branch = "main"

[submodule "src/robomaster_ros"]
	path = src/robomaster_ros
	url = git@github.com:EliaCereda/robomaster_ros.git
	branch = "main"

[submodule "src/simExtROS2"]
	path = src/simExtROS2
	url = git@github.com:EliaCereda/simExtROS2.git
	branch = "iron-4.6"

[submodule "src/RoboMaster-SDK"]
	path = src/RoboMaster-SDK
	url = git@github.com:EliaCereda/RoboMaster-SDK.git
	branch = "pixi"

[submodule "src/joystick_drivers"]
	path = src/joystick_drivers
	url = git@github.com:EliaCereda/joystick_drivers.git
	branch = "ros2-macos"

